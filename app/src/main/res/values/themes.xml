<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window only: everything visible is drawn by Compose. -->
    <style name="Theme.Blesk" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The system splash: the star on the theme's background, then the app's own window. -->
    <style name="Theme.Blesk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_star</item>
        <item name="postSplashScreenTheme">@style/Theme.Blesk</item>
    </style>
</resources>
