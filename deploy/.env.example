# scripts/deploy.sh creates deploy/.env with random secrets on the first run and keeps it afterwards.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=blesk
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# MinIO no longer publishes images on Docker Hub; this one is built from MinIO's source by Chainguard.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
# Either a domain (automatic Let's Encrypt certificate) ...
BLESK_DOMAIN=
# ... or empty domain plus the server's public IP (self-signed certificate pinned through the QR code).
BLESK_PUBLIC_IP=
# Caddyfile.domain or Caddyfile.ip
BLESK_CADDYFILE=Caddyfile.domain
