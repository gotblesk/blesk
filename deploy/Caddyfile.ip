# Without a domain: the self-signed certificate made by scripts/deploy.sh. The app trusts it by
# its public key hash, which it gets from the QR code.
{
	auto_https disable_certs
	# Clients connecting to a bare IP send no SNI; without this Caddy would not know which certificate to use.
	default_sni {$BLESK_PUBLIC_IP}
}

https://{$BLESK_PUBLIC_IP} {
	tls /certs/blesk.crt /certs/blesk.key
	# LiveKit signalling (WebSocket); the prefix is stripped because LiveKit serves from the root.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}
	handle {
		reverse_proxy server:8080
	}
}
