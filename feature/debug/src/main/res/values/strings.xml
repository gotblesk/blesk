    <string name="motion_title">Витрина движения</string>
    <string name="motion_intro">Все фирменные анимации и вибрации из брифа. Каждую можно проиграть отдельно и проверить на телефоне.</string>
    <string name="motion_animations">Анимации</string>
    <string name="motion_haptics">Вибрации</string>
    <string name="motion_play">Проиграть</string>
    <string name="motion_open">Отладка: витрина движения</string>
    <string name="motion_open_hint">Анимации и вибрации по одной</string>
    <string name="anim_send">1. Отправка — «отрыв»</string>
    <string name="anim_send_note">Капсула отрывается от поля и вливается в колонну</string>
    <string name="anim_receive">2. Входящее — «созревание»</string>
    <string name="anim_receive_note">Точки «печатает» сливаются и разворачиваются в сообщение</string>
    <string name="anim_status">3. Статусы</string>
    <string name="anim_status_note">Вспышка на «отправлено» и «доставлено», свет на «прочитано»</string>
    <string name="anim_thread">4. Ответ — «нить»</string>
    <string name="anim_thread_note">Перемычка между ответом и оригиналом</string>
    <string name="anim_reaction">5. Реакция — «прилипание»</string>
    <string name="anim_reaction_note">Реакция прилипает к сообщению с колебанием</string>
    <string name="anim_delete">6. Удаление — «схлопывание»</string>
    <string name="anim_delete_note">Сообщение тускнеет и сжимается, соседи стекаются</string>
    <string name="anim_melt">7. Тающий блеск</string>
    <string name="anim_melt_note">Блик гаснет по мере оставшегося времени</string>
    <string name="anim_failure">8. Ошибка отправки</string>
    <string name="anim_failure_note">Сообщение отлипает от колонны и становится матовым</string>
    <string name="anim_unread">9. Счётчик непрочитанных</string>
    <string name="anim_unread_note">Новые вливаются, при прочтении счётчик испаряется</string>
    <string name="anim_open_chat">11. Открытие чата</string>
    <string name="anim_open_chat_note">Аватар перетекает в шапку, переписка вытекает из строки — откроется демо-чат</string>
    <string name="anim_theme">12. Смена темы — «свет проходит»</string>
    <string name="anim_theme_note">Волна света перекрашивает экран, тема вернётся сама</string>
    <string name="anim_keys">13. Сверка ключей</string>
    <string name="anim_keys_note">Формы сливаются и вспыхивают; при каждом втором проигрывании — отталкиваются</string>
    <string name="anim_sweep">14. Первая защищённая сессия</string>
    <string name="anim_sweep_note">Белый блик проходит по шапке один раз</string>
    <string name="anim_wipe">15. «Удалить всё»</string>
    <string name="anim_wipe_note">Блики гаснут один за другим</string>
    <string name="anim_beacon">16. Входящий звонок — «маяк»</string>
    <string name="anim_beacon_note">Свет медленно обходит край аватара</string>
    <string name="anim_breath">17. Голос говорящего</string>
    <string name="anim_breath_note">Край аватара едва заметно дышит громкостью; в тишине неподвижен</string>
    <string name="anim_fire">18. «Огонь»</string>
    <string name="anim_fire_note">Спектральная вспышка по краю: звонок соединился, ключи сверены</string>
    <string name="anim_read_more">«Читать дальше»</string>
    <string name="anim_read_more_note">Нажми на сообщение — оно раскроется плавно</string>
    <string name="anim_toggle">Переключатель</string>
    <string name="anim_toggle_note">Шарик отлипает от края и перетекает к другому</string>
    <string name="haptic_tick">Тик</string>
    <string name="haptic_tick_note">Вкладка, порог жеста, шаг ползунка</string>
    <string name="haptic_stick">Слипание</string>
    <string name="haptic_stick_note">Капсулы слились, реакция прилипла, запись на замке</string>
    <string name="haptic_detach">Отрыв</string>
    <string name="haptic_detach_note">Сообщение отправлено, перемычка порвалась</string>
    <string name="haptic_success">Успех</string>
    <string name="haptic_success_note">Ключи сверены, звонок соединился, профиль сохранён</string>
    <string name="haptic_refuse">Отказ</string>
    <string name="haptic_refuse_note">Не отправилось, неверный код, действие недоступно</string>
    <string name="haptic_warn">Предупреждение</string>
    <string name="haptic_warn_note">Ключ сменился, нет доступа к микрофону или камере</string>
    <string name="haptic_heavy">Серьёзное действие</string>
    <string name="haptic_heavy_note">Человек заблокирован, опасный ползунок дотянут</string>
    <string name="haptic_menu">Меню</string>
    <string name="haptic_menu_note">Меню долгим нажатием</string>
    <string name="haptic_toggle_on">Переключатель: вкл</string>
    <string name="haptic_toggle_on_note">Щелчок включения</string>
    <string name="haptic_toggle_off">Переключатель: выкл</string>
    <string name="haptic_toggle_off_note">Щелчок выключения</string>
    <string name="haptic_beacon">Входящий звонок — «маяк»</string>
    <string name="haptic_beacon_note">В ритме света вокруг аватара</string>
    <string name="haptic_call_end">Конец звонка</string>
    <string name="haptic_call_end_note">Короткий низкий спад</string>
