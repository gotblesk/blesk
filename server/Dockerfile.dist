# syntax=docker/dockerfile:1
# The server as GitHub Actions built it (blesk-server.tar.gz in each release), unpacked into
# server/dist/ by scripts/deploy.sh. Building on the host needs Signal's Maven repository, which is
# blocked in some countries; this image needs nothing beyond Docker Hub.

FROM eclipse-temurin:21.0.12.1_1-jre-noble
RUN groupadd --system blesk && useradd --system --gid blesk --home-dir /opt/blesk-server blesk \
    && mkdir -p /var/lib/blesk /srv/blesk-attachments \
    && chown blesk:blesk /var/lib/blesk /srv/blesk-attachments
COPY server/dist/blesk-server /opt/blesk-server
USER blesk
ENV BLESK_PORT=8080 \
    BLESK_FS_DIR=/srv/blesk-attachments \
    JAVA_OPTS="-XX:MaxRAMPercentage=50 -Djava.io.tmpdir=/var/lib/blesk"
EXPOSE 8080
ENTRYPOINT ["/opt/blesk-server/bin/blesk-server"]
